---
// Final call to action (A1 #12). Variants: image, solid, split.
import Img from './Img.astro';
import BookButton from './BookButton.astro';
import TrustRow from './TrustRow.astro';
import type { Site } from '../lib/content/schema';
import type { BookingAdapter, BookingTarget } from '../lib/booking';
import theme from '/src/generated/theme.json';
interface Props { site: Site; adapter: BookingAdapter; heading: string; body?: string; label?: string; image?: string; video?: string; poster?: string; target?: BookingTarget; experience?: string }
const { site, adapter, heading, body, label, image, video, poster, target, experience } = Astro.props;
const v = (image || video) ? theme.variants.ctaBand : 'solid';
---
<section class:list={['relative overflow-hidden band', v === 'split' ? 'grid lg:grid-cols-2' : 'pad-x section']} data-reveal>
  {v === 'image' && (
    <div class="absolute inset-0">
      {video ? <video class="cover" autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true"><source src={video} type="video/mp4" /></video> : <Img src={image!} alt="" class="cover" sizes="100vw" widths={[768, 1440, 1920]} />}
      <div class="overlay"></div>
    </div>
  )}
  {v === 'split' && <div class="relative min-h-72 overflow-hidden">{video ? <video class="cover absolute inset-0" autoplay muted loop playsinline preload="metadata" poster={poster} aria-hidden="true"><source src={video} type="video/mp4" /></video> : <Img src={image!} alt="" class="cover absolute inset-0" sizes="50vw" widths={[768, 1080]} />}</div>}
  <div class:list={['relative', v === 'split' ? 'pad-x flex items-center py-16 lg:py-24' : 'container-xl py-8 text-center']}>
    <div class:list={v === 'split' ? 'max-w-xl' : 'mx-auto max-w-3xl'}>
      <h2 class="mb-4">{heading}</h2>
      {body && <p class="lede mb-8">{body}</p>}
      <div class:list={['flex flex-wrap gap-4', { 'justify-center': v !== 'split' }]}>
        <BookButton adapter={adapter} target={target} label={label} variant="alt-solid" experience={experience} />
        {adapter.giftUrl?.() && <BookButton adapter={adapter} gift variant="alt" />}
      </div>
      <TrustRow site={site} class:list={['mt-6', { 'justify-center': v !== 'split' }]} onBand />
    </div>
  </div>
</section>
