---
// Dates with a status, from their site only; future dates only.
import BookButton from './BookButton.astro';
import { futureDepartures, formatDate } from '../lib/site';
import type { BookingAdapter } from '../lib/booking';
import type { Experience } from '../lib/content/schema';
interface Props { experience: Experience; slug: string; adapter: BookingAdapter; id?: string }
const { experience: e, slug, adapter, id = 'availability' } = Astro.props;
const rows = futureDepartures(e).slice(0, 12);
const label: Record<string, string> = { open: 'Places available', limited: 'Limited places', full: 'Full', private: 'Private group' };
---
{rows.length > 0 && (
  <section id={id} class="anchor-offset" data-reveal>
    <h2 class="mb-6">Departures</h2>
    <table class="w-full border-collapse text-left">
      <thead><tr class="label" style="color:var(--muted)"><th class="border-b border-line py-2 pr-4 font-medium">Dates</th><th class="border-b border-line py-2 pr-4 font-medium">Status</th><th class="border-b border-line py-2"><span class="sr-only">Book</span></th></tr></thead>
      <tbody>
        {rows.map((d) => (
          <tr>
            <td class="border-b border-line py-3 pr-4">{formatDate(d.start)}{d.end && d.end !== d.start ? ` to ${formatDate(d.end)}` : ''}</td>
            <td class="border-b border-line py-3 pr-4"><span class:list={['badge', { 'badge-accent': d.status === 'limited' }]}>{label[d.status]}</span></td>
            <td class="border-b border-line py-3 text-right">{d.status !== 'full' && <BookButton adapter={adapter} target={{ itemId: e.booking.itemId ?? slug, url: e.booking.url }} experience={slug} variant="secondary" small />}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
)}
