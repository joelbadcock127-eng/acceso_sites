---
// Alternating feature blocks (A1 #4): a video or a four photo mosaic, a
// heading, one short paragraph and a link. Needs a video or 4 good images;
// with 1 to 3 images it uses one large image, with none it hides.
import Img from './Img.astro';
import type { Site } from '../lib/content/schema';
import theme from '/src/generated/theme.json';
interface Props { features: Site['home']['features'] }
const { features } = Astro.props;
const v = theme.variants.featureSplit;
const usable = features.filter((f) => f.video || f.images.length >= 1);
---
{usable.length > 0 && (
  <section class="pad-x section">
    <div class="container-xl grid gap-16 lg:gap-24">
      {usable.map((f, i) => {
        const flip = v === 'alternate' ? i % 2 === 1 : v === 'mosaicLeft' ? false : false;
        const mosaic = !f.video && f.images.length >= 4;
        return (
          <div class:list={['grid items-center gap-8 lg:gap-16', v === 'stacked' ? 'lg:grid-cols-1' : 'lg:grid-cols-2']} data-reveal>
            <div class:list={['overflow-hidden', { 'lg:order-2': flip }]} style="border-radius:var(--radius)">
              {f.video ? (
                <video class="aspect-square w-full object-cover" autoplay muted loop playsinline preload="metadata" poster={f.poster} aria-label={f.heading}><source src={f.video} type="video/mp4" /></video>
              ) : mosaic ? (
                <div class:list={['mosaic', { 'lg:grid-cols-4': v === 'stacked' }]}>{f.images.slice(0, 4).map((im) => <Img src={im.src} alt={im.alt} sizes="(min-width:1024px) 25vw, 50vw" widths={[480, 768]} />)}</div>
              ) : (
                <Img src={f.images[0].src} alt={f.images[0].alt} class="aspect-[4/3] w-full object-cover" sizes="(min-width:1024px) 50vw, 100vw" widths={[768, 1080, 1440]} />
              )}
            </div>
            <div class:list={['max-w-xl', { 'lg:order-1': flip, 'mx-auto text-center': v === 'stacked' }]}>
              <h2 class="mb-4">{f.heading}</h2>
              <p class="lede" style="color:var(--muted)">{f.body}</p>
              {f.link && <a href={f.link.href} class="btn-link mt-5">{f.link.label}</a>}
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}
