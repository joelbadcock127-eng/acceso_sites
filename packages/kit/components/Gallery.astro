---
// Gallery with a full screen, swipeable, keyboard accessible lightbox (A4b).
// 6 or more images scoring 4 or better (unscored images are allowed in demo content).
import Img from './Img.astro';
interface Props { images: { src: string; alt: string; score?: number }[]; heading?: string; id?: string }
const { images, heading = 'Gallery', id = 'gallery' } = Astro.props;
const list = images.filter((i) => (i.score ?? 4) >= 4).slice(0, 12);
---
{list.length >= 6 && (
  <section id={id} class="anchor-offset" data-reveal data-gallery>
    <h2 class="mb-6">{heading}</h2>
    <ul class="grid grid-cols-2 gap-2 md:grid-cols-3">
      {list.map((im, i) => (
        <li class:list={{ 'col-span-2 row-span-2': i === 0 }}>
          <button type="button" class="block h-full w-full overflow-hidden" data-lightbox-open={i} aria-label={`Open image ${i + 1}: ${im.alt}`}>
            <Img src={im.src} alt={im.alt} class:list={['h-full w-full object-cover', i === 0 ? 'aspect-square' : 'aspect-square']} sizes="(min-width:768px) 33vw, 50vw" widths={[480, 768, 1080]} />
          </button>
        </li>
      ))}
    </ul>
    <dialog class="lightbox m-auto h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/90" data-lightbox aria-label="Image viewer">
      <div class="flex h-full flex-col text-white">
        <div class="flex items-center justify-between p-3"><span data-lightbox-count class="text-sm"></span><button type="button" class="flex h-11 w-11 items-center justify-center text-2xl" data-lightbox-close aria-label="Close">×</button></div>
        <div class="relative flex flex-1 items-center justify-center overflow-hidden">
          <button type="button" class="absolute left-2 top-1/2 h-11 w-11 -translate-y-1/2 text-3xl" data-lightbox-prev aria-label="Previous image">‹</button>
          <img data-lightbox-img class="max-h-full max-w-full object-contain" alt="" />
          <button type="button" class="absolute right-2 top-1/2 h-11 w-11 -translate-y-1/2 text-3xl" data-lightbox-next aria-label="Next image">›</button>
        </div>
        <p data-lightbox-caption class="p-3 text-center text-sm"></p>
      </div>
    </dialog>
    <script>
      document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
        const dlg = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
        const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
        const cap = dlg.querySelector<HTMLElement>('[data-lightbox-caption]')!;
        const count = dlg.querySelector<HTMLElement>('[data-lightbox-count]')!;
        const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));
        const srcs = thumbs.map((b) => { const i = b.querySelector('img')!; const pic = b.querySelector('source'); const best = (pic?.srcset || i.srcset || i.src).split(',').pop()!.trim().split(' ')[0]; return { src: best, alt: i.alt }; });
        let cur = 0;
        const show = (i: number) => { cur = (i + srcs.length) % srcs.length; img.src = srcs[cur].src; img.alt = srcs[cur].alt; cap.textContent = srcs[cur].alt; count.textContent = `${cur + 1} of ${srcs.length}`; };
        thumbs.forEach((b, i) => b.addEventListener('click', () => { show(i); dlg.showModal(); }));
        dlg.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dlg.close());
        dlg.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(cur - 1));
        dlg.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(cur + 1));
        dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        let x0 = 0; dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true }); dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1)); });
      });
    </script>
  </section>
)}
