---
// Itinerary accordion (experience #6): one item per day or time slot.
interface Props { items: { label: string; title: string; body: string }[]; heading?: string; id?: string; openFirst?: boolean }
const { items, heading = 'Itinerary', id = 'itinerary', openFirst = true } = Astro.props;
---
{items.length > 0 && (
  <section id={id} class="anchor-offset" data-reveal>
    <h2 class="mb-6">{heading}</h2>
    <div>
      {items.map((it, i) => (
        <details class="accordion" open={openFirst && i === 0}>
          <summary><span class="flex items-baseline gap-4"><span class="label w-24 flex-none" style="color:var(--muted)">{it.label}</span><span>{it.title}</span></span></summary>
          <div class="body prose md:pl-28" set:html={it.body.split(/\n\n+/).map((p) => `<p>${p}</p>`).join('')} />
        </details>
      ))}
    </div>
  </section>
)}
