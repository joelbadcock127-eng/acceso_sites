---
// Key facts (experience #2): duration, distance, grade with explainer, group
// size, price from. 3 or more facts or it hides. Also carries NextDeparture.
import Icon from './Icon.astro';
import NextDeparture from './NextDeparture.astro';
import { keyFacts } from '../lib/site';
import type { Experience } from '../lib/content/schema';
import theme from '/src/generated/theme.json';
interface Props { experience: Experience; onBand?: boolean }
const { experience, onBand = false } = Astro.props;
const facts = keyFacts(experience);
const v = theme.variants.keyFacts;
const icon: Record<string, string> = { Duration: 'clock', Distance: 'distance', Grade: 'grade', 'Group size': 'group', Price: 'star' };
const next = experience.departures.length || experience.season;
---
{facts.length >= 3 && (
  <div class:list={['key-facts', v === 'pills' ? 'flex flex-wrap gap-2' : v === 'stacked' ? 'grid gap-3 sm:grid-cols-2' : 'grid grid-cols-2 gap-px border md:grid-cols-3 lg:grid-cols-5', { 'border-line': v === 'banner' && !onBand, 'border-band-ink/30': v === 'banner' && onBand }]} style={v === 'banner' ? `background:${onBand ? 'color-mix(in srgb, var(--band-ink) 30%, transparent)' : 'var(--line)'}` : undefined}>
    {facts.map((f) => (
      <div class:list={[v === 'pills' ? 'badge py-2 text-sm normal-case tracking-normal text-ink' : v === 'stacked' ? 'flex items-center gap-3 border-b border-line py-2' : 'p-4', { 'bg-ground': v === 'banner' && !onBand, 'bg-band': v === 'banner' && onBand }]} style={v === 'banner' && onBand ? 'background:var(--band)' : undefined}>
        {v !== 'pills' && <Icon name={icon[f.k] ?? 'info'} size={20} class="mb-2 opacity-70" />}
        <div class:list={['label', { 'sr-only': v === 'pills' }]} style={onBand ? undefined : 'color:var(--muted)'}>{f.k}</div>
        <div class="font-medium">{f.v}</div>
        {f.sub && v !== 'pills' && <div class="mt-1 text-xs" style={onBand ? undefined : 'color:var(--muted)'}>{f.sub}</div>}
      </div>
    ))}
    {next && v === 'banner' && <div class:list={['flex items-center p-4', { 'bg-ground': !onBand }]} style={onBand ? 'background:var(--band)' : undefined}><NextDeparture experience={experience} /></div>}
  </div>
)}
