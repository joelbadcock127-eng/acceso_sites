---
// Small badge: "Next departure 12 October" or "Runs April to October" (A4).
import Icon from './Icon.astro';
import { nextDepartureLine } from '../lib/site';
import type { Experience } from '../lib/content/schema';
interface Props { experience: Experience; class?: string }
const { experience, class: cls = '' } = Astro.props;
const line = nextDepartureLine(experience);
---
{line && <span class:list={['badge', cls]}><Icon name="calendar" size={14} />{line}</span>}
