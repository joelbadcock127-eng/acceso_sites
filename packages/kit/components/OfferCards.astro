---
// Offer cards (A1 #6). Needs 2 or more experiences. Variants: three across,
// large feature plus two, or a list with images.
import Img from './Img.astro';
import NextDeparture from './NextDeparture.astro';
import { formatPriceShort } from '../lib/site';
import type { ExperienceEntry } from '../lib/site';
import type { Site } from '../lib/content/schema';
import theme from '/src/generated/theme.json';
interface Props { site: Site; experiences: ExperienceEntry[]; heading?: string; intro?: string; limit?: number }
const { site, experiences, heading = site.home.offers?.heading ?? 'Our walks', intro = site.home.offers?.intro, limit } = Astro.props;
const v = theme.variants.offerCards;
// The list variant carries every experience (it is a list); the card variants show three.
const items = experiences.filter((e) => e.data.cardImages[0] || e.data.heroImage || e.data.gallery[0]).slice(0, limit ?? (theme.variants.offerCards === 'list' ? 6 : 3));
const img = (e: ExperienceEntry) => e.data.cardImages[0] ?? (e.data.heroImage ? { src: e.data.heroImage, alt: e.data.heroAlt ?? '' } : e.data.gallery[0]);
---
{items.length >= 2 && (
  <section class="pad-x section" id="offers" data-reveal>
    <div class="container-xl">
      <div class="mb-10 max-w-2xl">
        <h2 class="mb-3">{heading}</h2>
        {intro && <p class="lede" style="color:var(--muted)">{intro}</p>}
      </div>
      {v === 'list' ? (
        <ul class="grid divide-y divide-line border-y border-line">
          {items.map((e) => (
            <li class="grid items-center gap-6 py-6 sm:grid-cols-[10rem_1fr_auto]">
              <a href={`/experiences/${e.slug}`} class="block overflow-hidden" style="border-radius:var(--radius)"><Img src={img(e).src} alt={img(e).alt} class="aspect-[4/3] w-full object-cover" sizes="160px" widths={[320, 480]} /></a>
              <div>
                <h3 class="text-2xl"><a href={`/experiences/${e.slug}`}>{e.data.title}</a></h3>
                <p class="mt-1" style="color:var(--muted)">{e.data.summary}</p>
                <NextDeparture experience={e.data} class="mt-2" />
              </div>
              <div class="text-right">
                {formatPriceShort(e.data.priceFrom) && <div class="font-medium">{formatPriceShort(e.data.priceFrom)}</div>}
                <a href={`/experiences/${e.slug}`} class="btn-link">Explore {e.data.title}</a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <ul class:list={['grid gap-8', v === 'featurePlusTwo' ? 'lg:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3']}>
          {items.map((e, i) => (
            <li class:list={['group', { 'lg:row-span-2': v === 'featurePlusTwo' && i === 0 }]}>
              <a href={`/experiences/${e.slug}`} class="block overflow-hidden" style="border-radius:var(--radius)">
                <Img src={img(e).src} alt={img(e).alt} class:list={['w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', v === 'featurePlusTwo' && i === 0 ? 'aspect-[4/5]' : 'aspect-[16/10]']} sizes="(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" widths={[480, 768, 1080]} />
              </a>
              <div class="mt-4 flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-2xl"><a href={`/experiences/${e.slug}`}>{e.data.title}</a></h3>
                {formatPriceShort(e.data.priceFrom) && <span class="text-sm font-medium">{formatPriceShort(e.data.priceFrom)}</span>}
              </div>
              <p class="mt-1" style="color:var(--muted)">{e.data.summary}</p>
              <div class="mt-3 flex flex-wrap items-center gap-4"><a href={`/experiences/${e.slug}`} class="btn-link">Explore {e.data.title}</a><NextDeparture experience={e.data} /></div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
