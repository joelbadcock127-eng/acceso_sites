---
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import TapToChat from '../components/TapToChat.astro';
import LocationBlock from '../components/LocationBlock.astro';
import { pageData } from '../lib/page';
import { breadcrumb } from '../lib/jsonld';
const { site, experiences } = await pageData();
---
<Base title={`Contact | ${site.business.name}`} description={`Get in touch with ${site.business.name}${site.business.baseTown ? ` in ${site.business.baseTown}` : ''}.`} jsonLd={[breadcrumb(site, [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}>
  <section class="pad-x section-md"><div class="container-xl"><h1>{site.contact.heading ?? 'Contact'}</h1>{site.contact.intro && <p class="lede mt-3 max-w-2xl" style="color:var(--muted)">{site.contact.intro}</p>}<div class="mt-6"><TapToChat site={site} /></div></div></section>
  <ContactSection site={site} heading="Send a message" experiences={experiences.map((e) => e.data.title)} />
  <LocationBlock site={site} />
</Base>
